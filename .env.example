# 企业微信 → 自建应用（需加入微信客服的「可调用接口的应用」）
WECOM_CORP_ID=
WECOM_TOKEN=
WECOM_AES_KEY=
WECOM_SECRET=

# 公网 HTTPS 部署
PUBLIC_DOMAIN=
CALLBACK_PATH=/webhook/kf

# 可选。设置全套即启用坚果云 WebDAV
DAV_URL=
DAV_USER=
DAV_PASS=

# 可选。为空时关闭重放接口
ADMIN_TOKEN=

OFFICIAL_FETCH=false
OFFICIAL_FETCH_TIMEOUT=8s
OFFICIAL_FETCH_MAX_IMAGES=20
MEDIA_MAX_MB=20
DOUYIN_MAX_DURATION=10m
